@model IEnumerable<BeautySalon.Data.Models.Service>

@{
    ViewData["Title"] = "Услуги";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-primary fw-bold"><i class="bi bi-scissors"></i> Предлагани услуги</h1>
    <a asp-action="Create" class="btn btn-success shadow-sm">
        <i class="bi bi-plus-circle"></i> Добави нова услуга
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Име на услугата</th>
                    <th>Описание</th>
                    <th>Цена</th>
                    <th class="text-end pe-4">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@Html.DisplayFor(modelItem => item.Name)</td>
                        <td class="text-muted">@Html.DisplayFor(modelItem => item.Description)</td>
                        <td><span class="badge bg-info text-dark fs-6">@item.Price.ToString("F2") лв.</span></td>
                        <td class="text-end pe-3">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1">
                                <i class="bi bi-pencil"></i> Редактирай
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">
                                <i class="bi bi-info-circle"></i> Детайли
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Изтрий
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>