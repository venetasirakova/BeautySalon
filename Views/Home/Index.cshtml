@{
    ViewData["Title"] = "Начало";
}

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm text-center">
    <div class="container-fluid py-3">
        <h1 class="display-4 fw-bold text-primary">Добре дошли в Beauty Salon!</h1>
        <p class="fs-4 text-muted mt-3">
            Вашето любимо място за красота, релакс и стил.
            Управлявайте лесно предлаганите услуги и запазените си часове.
        </p>
        <div class="d-flex justify-content-center gap-3 mt-4">
            <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary btn-lg px-4">
                Запази час
            </a>
            <a asp-controller="Services" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                Разгледай услугите
            </a>
        </div>
    </div>
</div>

<div class="row text-center mt-5">
    <div class="col-md-4 mb-3">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="card-body">
                <h5 class="card-title fw-bold text-primary">Разнообразни услуги</h5>
                <p class="card-text text-muted">Предлагаме широка гама от козметични и фризьорски процедури.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="card-body">
                <h5 class="card-title fw-bold text-primary">Лесно резервиране</h5>
                <p class="card-text text-muted">Запазете час за няколко секунди бързо и удобно.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="card-body">
                <h5 class="card-title fw-bold text-primary">Професионална грижа</h5>
                <p class="card-text text-muted">Нашият екип от специалисти се грижи за перфектния ви вид.</p>
            </div>
        </div>
    </div>
</div>