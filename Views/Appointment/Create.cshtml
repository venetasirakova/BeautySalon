@model BeautySalon.Data.Models.Appointment

@{
    ViewData["Title"] = "Запази час";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-calendar-plus"></i> Запази нов час</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="ClientName" class="form-label fw-bold">
                            <i class="bi bi-person"></i> Име на клиент
                        </label>
                        <input asp-for="ClientName" class="form-control" placeholder="Въведете двете си имена" />
                        <span asp-validation-for="ClientName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ClientPhone" class="form-label fw-bold">
                            <i class="bi bi-telephone"></i> Телефонен номер
                        </label>
                        <input asp-for="ClientPhone" class="form-control" placeholder="0888123456" />
                        <span asp-validation-for="ClientPhone" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DateTime" class="form-label fw-bold">
                            <i class="bi bi-clock"></i> Дата и час
                        </label>
                        <input asp-for="DateTime" class="form-control" type="datetime-local" />
                        <span asp-validation-for="DateTime" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ServiceId" class="form-label fw-bold">
                            <i class="bi bi-scissors"></i> Изберете услуга
                        </label>
                        <select asp-for="ServiceId" class="form-select" asp-items="ViewBag.ServiceId">
                            <option value="">-- Изберете услуга --</option>
                        </select>
                        <span asp-validation-for="ServiceId" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-between pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Назад към списъка
                        </a>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check-circle"></i> Запази час
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}